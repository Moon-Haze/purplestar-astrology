{
	"name": "purplestar-astrology-skill",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "紫微斗数 skill 仓库（倪海厦《天纪》三合派）。",
	"scripts": {
		"test": "node test/lib/run.ts",
		"test:corpus": "tsx test/tools/full-corpus.ts",
		"query": "tsx tools/db/query.ts",
		"bench:startup": "tsx tools/bench/startup.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"review": "tsx tools/review-gate.ts",
		"lint": "eslint scripts/ tools/ test/",
		"lint:fix": "eslint scripts/ tools/ test/ --fix",
		"format": "prettier --write scripts/ tools/ test/"
	},
	"dependencies": {
		"iztro": "2.6.1",
		"lunar-typescript": "1.8.6"
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/eslint-parser": "^8.0.7",
		"@duckdb/node-api": "1.5.5-r.5",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"tsx": "^4.19.1",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
