{
    "MD033": {
        "allowed_elements": [
            "h2",
            "span",
            "font",
            "br",
            "li",
            "table",
            "tr",
            "td"
        ]
    },
    "MD060": false,
    "code-block-style": {
        "style": "fenced"
    },
    "code-fence-style": {
        "style": "backtick"
    },
    "emphasis-style": {
        "style": "asterisk"
    },
    "extended-ascii": {
        "ascii-only": true
    },
    "fenced-code-language": {
        "allowed_languages": [
            "c",
            "c++",
            "diff",
            "bash",
            "html",
            "plaintext",
            "js",
            "javascript",
            "json",
            "markdown",
            "text",
            "txt",
            "verilog",
            "shell",
            "sql",
            "ts",
            "typescript"
        ],
        "language_only": true
    },
    "heading-style": {
        "style": "atx"
    },
    "hr-style": {
        "style": "---"
    },
    "line-length": {
        "strict": true,
        "code_blocks": false,
        "line_length": 2000
    },
    "link-image-style": {
        "collapsed": false,
        "shortcut": false,
        "url_inline": false
    },
    "no-duplicate-heading": {
        "siblings_only": true
    },
    "no-hard-tabs": {
        "code_blocks": false
    },
    "ol-prefix": {
        "style": "ordered"
    },
    "proper-names": {
        "code_blocks": false,
        "names": [
            "Cake.Markdownlint",
            "CommonMark",
            "JavaScript",
            "Markdown",
            "markdown-it",
            "markdownlint",
            "Node.js"
        ]
    },
    "reference-links-images": {
        "shortcut_syntax": true
    },
    "strong-style": {
        "style": "asterisk"
    },
    "ul-style": {
        "style": "dash"
    }
}