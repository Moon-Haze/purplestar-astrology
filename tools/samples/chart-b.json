  "patterns": [
    {
      "name": "机月同梁",
      "level": 60,
      "palaces": [
        "官禄宫",
        "迁移宫",
        "财帛宫"
      ],
      "conditions": {
        "required": [
          "天机、太阴、天梁会入命宫三方四正（四星中 3 星）"
        ],
        "bonus": [
          "再会昌曲",
          "再会化科"
        ],
        "breaking": [
          "三方四正只齐 3 星（机月同梁不全格）"
        ]
      },
      "description": "三方四正会齐天机、太阴、天梁，机月同梁不全格，文质带谋，但稳定度不如四星齐。仍宜公职、教研、医疗、服务等需要积累与稳定的行业，关键看缺位星与四化的配合。",
      "topicDescription": "天机、太阴、天同、天梁会入命宫三方四正，惟四星中只齐三星——机月同梁为「不全格」，古训「机月同梁格，作吏人」的稳健路线仍在，但格局力量打折，成败更看缺位之星与四化的配合；宜公教、政府、传播、文化事业，不宜冒险创业。",
      "source": "《紫微斗数全书·机月同梁格》（降级版）"
    },
    {
      "name": "日月同宫",
      "level": 75,
      "palaces": [
        "官禄宫"
      ],
      "conditions": {
        "required": [
          "太阳太阴同入未宫"
        ],
        "bonus": [
          "未宫日月同辉（古书云未宫日月双美）",
          "昌曲会照"
        ],
        "breaking": [
          "日月宫煞星同坐"
        ]
      },
      "description": "太阳太阴于未宫同宫，阴阳平衡，文武兼备。主异性缘佳、事业顺遂、名声远播。未宫日月双美尤佳。",
      "topicDescription": "太阳太阴同宫，日月同照一处——一生常在名声、情感、家庭责任之间取得平衡；庙旺则左右逢源，落陷则内外压力并重。",
      "source": "《紫微斗数全书》"
    },
    {
      "name": "昌曲同会",
      "level": 75,
      "palaces": [
        "命宫"
      ],
      "conditions": {
        "required": [
          "文昌、文曲同会命宫三方四正"
        ]
      },
      "description": "文昌文曲同会三方四正，主才华横溢、口才文笔俱佳。宜走需要表达与文采的行业，化科加持则名声大显。",
      "source": "《紫微斗数全书·文星论》"
    },
    {
      "name": "文昌守命",
      "level": 75,
      "palaces": [
        "命宫"
      ],
      "conditions": {
        "required": [
          "文昌坐命宫"
        ]
      },
      "description": "文昌坐命宫，为\"文星守命\"——主聪明俊秀、才华出众，利考试与名声，宜文教、艺术、传媒或需要专业技艺的行当，以才华换取名利最为顺畅。",
      "topicDescription": "文昌坐命——才华横溢，文采出众，有学识与艺术天赋，是科甲名声之星。主考试运佳，学业顺遂；适合文教、艺术、传媒或需要专业技艺的领域，以才华换取名利是最顺畅的人生路线。",
      "source": "《紫微斗数全书·十二宫论·命宫》"
    },
    {
      "name": "文曲化忌",
      "level": 40,
      "palaces": [
        "财帛宫"
      ],
      "conditions": {
        "required": [
          "文曲带生年化忌"
        ]
      },
      "description": "文曲化忌——文星受伤，主文书、契约、考试、言论一类的事易生暗亏：签约核对条款、考试防疏漏、言语慎出口，化忌是功课而非定论。",
      "topicDescription": "文曲化忌——口才表达与情感感性方面易生波折；社交场合的言语需谨慎，桃花事务多纠葛，文艺创作虽有灵感但落地易生误解。",
      "source": "传统口诀（本仓古籍库无直接出处）"
    }
  ],
