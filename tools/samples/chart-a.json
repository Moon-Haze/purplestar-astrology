  "patterns": [
    {
      "name": "紫府同宫",
      "level": 75,
      "palaces": [
        "迁移宫"
      ],
      "conditions": {
        "required": [
          "紫微天府同入迁移宫（照命，力减）"
        ],
        "bonus": [
          "左辅右弼同会",
          "再会昌曲"
        ],
        "breaking": []
      },
      "description": "紫微天府同宫于迁移宫，照拱命宫而非坐守，主一生有贵人贵气依托，但本身不一定大富贵，需看会照吉煞而定。",
      "topicDescription": "紫微天府同处寅申宫，且在迁移宫照拱命宫——南北二帝同坐，福禄双全，一生衣食无忧；惟非坐命，贵气照入而非自居，成就多借外力与际遇，需看会照吉煞而定。",
      "source": "《紫微斗数全书·紫府同宫格》"
    },
    {
      "name": "武贪格",
      "level": 90,
      "palaces": [
        "福德宫",
        "财帛宫"
      ],
      "conditions": {
        "required": [
          "武曲贪狼对宫拱照",
          "会照命宫三方"
        ],
        "bonus": [
          "再遇火星/铃星（火贪/铃贪叠加）"
        ],
        "breaking": []
      },
      "description": "武曲贪狼会命，财星与桃花欲望星交辉，古书云\"武贪不发少年人\"——三十岁后方能厚积薄发。主中年以后大富大贵，财源由人脉、应酬、欲望管理而来，适合金融、投机、销售、娱乐业。",
      "source": "《紫微斗数骨髓赋》"
    },
    {
      "name": "杀破狼",
      "level": 40,
      "palaces": [
        "命宫",
        "官禄宫",
        "财帛宫"
      ],
      "conditions": {
        "required": [
          "七杀、破军、贪狼三星齐入命宫三方四正"
        ],
        "bonus": [
          "辅弼同会（变动中得贵人）"
        ],
        "breaking": [
          "煞星过重（动而无成）"
        ]
      },
      "description": "七杀、破军、贪狼三星会命，开创闯荡之命格。一生变动多、不甘平凡，宜创业、军警、业务、销售。中年后才能稳定守成，年轻时易因冲动失利。",
      "topicDescription": "七杀、破军、贪狼会照命宫三方四正，形成杀破狼格——一生变动大、开创性强，适合走创业、技术、军警、外地发展路线，关键在以行动力换格局。",
      "source": "《紫微斗数全书·杀破狼》"
    },
    {
      "name": "廉相格",
      "level": 60,
      "palaces": [
        "夫妻宫"
      ],
      "conditions": {
        "required": [
          "廉贞天相同宫"
        ],
        "bonus": [
          "左辅会照"
        ],
        "breaking": []
      },
      "description": "廉贞天相同宫，印绶格局，主秉公处事、清廉之名，宜任公职、行政管理、法务、企划。怕见擎羊化忌，则反主官非。",
      "topicDescription": "廉贞天相同宫成廉相格，才艺、制度、协调并重；格局清贵，宜法务、行政、管理、审美与规则并行的领域。",
      "source": "《紫微斗数全书》"
    },
    {
      "name": "昌曲同会",
      "level": 75,
      "palaces": [
        "命宫"
      ],
      "conditions": {
        "required": [
          "文昌、文曲同会命宫三方四正"
        ]
      },
      "description": "文昌文曲同会三方四正，主才华横溢、口才文笔俱佳。宜走需要表达与文采的行业，化科加持则名声大显。",
      "source": "《紫微斗数全书·文星论》"
    },
    {
      "name": "辅弼同会",
      "level": 75,
      "palaces": [
        "命宫"
      ],
      "conditions": {
        "required": [
          "左辅、右弼同会命宫三方四正"
        ]
      },
      "description": "左辅右弼同会命宫三方四正，主一生贵人不绝、人缘极佳。最宜领导岗位与团队合作型工作。倪师说「辅弼夹命，平生贵人多」——你不是单打独斗的命，要善用人际网络。",
      "source": "《紫微斗数全书·辅弼论》"
    },
    {
      "name": "魁钺同会",
      "level": 75,
      "palaces": [
        "命宫"
      ],
      "conditions": {
        "required": [
          "天魁、天钺同会命宫三方四正"
        ]
      },
      "description": "天魁天钺同会命宫三方四正，主\"天乙贵人\"加持，关键时刻总有贵人提携。倪师说「魁钺夹命，必为贵人」——遇到困难时身边会出现得力相助者，宜主动维护人脉。",
      "source": "《紫微斗数全书·魁钺论》"
    },
    {
      "name": "七杀朝斗格",
      "level": 90,
      "palaces": [
        "命宫"
      ],
      "conditions": {
        "required": [
          "七杀居寅宫或申宫",
          "七杀坐命宫或迁移宫"
        ]
      },
      "description": "七杀居命宫（寅或申），对宫紫微天府相照——古书云\"七杀朝斗，爵禄荣昌\"，是武职大贵之格，最宜军警政界、企业高管，一生贵气难挡。",
      "topicDescription": "七杀居寅申，对宫紫微天府相照——倪海夏说「爵禄荣昌」，这是武职大贵的格局，最宜军警政界或企业高管，一生贵气难挡。",
      "source": "《紫微斗数骨髓赋·七杀星论》"
    },
    {
      "name": "日月并明格",
      "level": 90,
      "palaces": [
        "田宅宫",
        "疾厄宫"
      ],
      "conditions": {
        "required": [
          "太阳入庙（bright）",
          "太阴入庙（bright）"
        ]
      },
      "description": "太阳太阴同时入庙旺，号\"日月并明\"——主一生贵人多助、行事左右逢源，名声与实利可以兼得，宜走动、宜公众事务；日月分居两宫亦成格，不必同宫。",
      "topicDescription": "太阳太阴同时入庙旺——倪海夏说「做事情左右逢源，一辈子做事情荣华」，此格局代表日月同辉，一生贵人多，做事顺遂，名利双全。",
      "source": "传统口诀（本仓古籍库无直接出处）"
    },
    {
      "name": "紫府朝垣格",
      "level": 90,
      "palaces": [
