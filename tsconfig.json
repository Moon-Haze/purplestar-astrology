{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./skills/purplestar-astrology/scripts/*"]
    }
  },
  "include": ["skills/**/*.ts", "test/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "reference"]
}
