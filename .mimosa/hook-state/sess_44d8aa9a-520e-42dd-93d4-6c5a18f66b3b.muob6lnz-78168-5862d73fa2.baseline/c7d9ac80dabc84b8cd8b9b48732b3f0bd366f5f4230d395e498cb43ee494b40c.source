	string,
	{
		/** 一句话核心断语（合盘输出里的主行） */
		summary: string;
		/** 吉象的条件与表现（三方吉曜、化禄、庙旺等前提） */
		good: string;
		/** 凶象与注意事项（化忌、落陷、会煞、特定宫位组合等） */
		bad: string;
		/** 配偶的外形与性格描述 */
		spouse_traits: string;
		/** 婚期建议（早晚婚、年龄差等） */
		timing: string;
		/** 倪海夏原话（可选，缺省表示该星无可引原文） */
		ni_quote?: string;
	}
