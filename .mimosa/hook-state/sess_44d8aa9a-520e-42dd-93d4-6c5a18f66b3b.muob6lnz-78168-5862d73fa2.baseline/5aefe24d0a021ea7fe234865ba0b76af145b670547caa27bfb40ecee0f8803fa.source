{
  "name": "ziwei-samples-toolkit",
  "version": "1.0.0",
  "description": "紫微斗数样本批量生成工具包（倪海厦体系）",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "tsx scripts/generate-samples.ts --mode=preview --out=./samples-out",
    "mini":    "tsx scripts/generate-samples.ts --mode=mini    --out=./samples-out",
    "full":    "tsx scripts/generate-full-parallel.ts --out=./samples-out",
    "full:single": "tsx scripts/generate-samples.ts --mode=full --out=./samples-out",
    "validate:nihaixia": "tsx scripts/validate-nihaixia-constraints.ts",
    "audit:samples": "tsx scripts/audit-samples.ts"
  },
  "dependencies": {
    "iztro": "^2.5.8",
    "lunar-javascript": "^1.7.3"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
